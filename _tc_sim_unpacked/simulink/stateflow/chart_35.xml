      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function alpha = blend_alpha(Start_Blend, End_Blend, Vehicle_Speed)

% Smoothly blends from 0 to 1 based on vehicle speed

    % Prevent divide-by-zero or bad inputs
    if End_Blend &lt;= Start_Blend
        if Vehicle_Speed &gt;= End_Blend
            alpha = 1;
        else
            alpha = 0;
        end
        return;
    end

    % Linear blend
    alpha = (Vehicle_Speed - Start_Blend) / (End_Blend - Start_Blend);

    % Clamp to 0 to 1
    if alpha &lt; 0
        alpha = 0;
    elseif alpha &gt; 1
        alpha = 1;
    end

    % Smoothstep shaping
    alpha = alpha * alpha * (3 - 2 * alpha);
end</P>
      </eml>
    </state>
